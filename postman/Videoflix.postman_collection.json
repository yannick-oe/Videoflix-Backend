    {
      "name": "2 Registration",
      "description": "One account per run. Its address is built from a timestamp in the pre-request script of the first request, so the folder needs no cleanup between runs.",
      "item": [
        {
          "name": "register the account of this run",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const stamp = Date.now();",
                  "pm.collectionVariables.set(\"email\", `videoflix.runner.${stamp}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responds 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const account = pm.response.json();",
                  "",
                  "pm.test(\"the body carries the account and its activation token\", function () {",
                  "    pm.expect(account.user.email).to.eql(pm.collectionVariables.get(\"email\"));",
                  "    pm.expect(account.user.id).to.be.a(\"number\");",
                  "    pm.expect(account.token).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "",
                  "const uidb64 = Buffer.from(String(account.user.id), \"utf8\")",
                  "    .toString(\"base64\")",
                  "    .replace(/\\+/g, \"-\")",
                  "    .replace(/\\//g, \"_\")",
                  "    .replace(/=+$/, \"\");",
                  "",
                  "pm.collectionVariables.set(\"uidb64\", uidb64);",
                  "pm.collectionVariables.set(\"activation_token\", account.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/register/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "register",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{email}}\",\n    \"password\": \"{{password}}\",\n    \"confirmed_password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "register with mismatched passwords",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responds 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"the confirmation field carries the error\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"confirmed_password\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/register/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "register",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"mismatch.{{email}}\",\n    \"password\": \"{{password}}\",\n    \"confirmed_password\": \"{{wrong_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "register the same address twice",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responds 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"the email field carries the error\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"email\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/register/",
              "host": [
