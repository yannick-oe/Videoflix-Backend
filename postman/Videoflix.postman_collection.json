    {
      "name": "6 Streaming with real media",
      "description": "These two requests need a converted video. The environment ships video_id empty and both requests then skip their assertions; set it to the id of a converted video to check the 200.",
      "item": [
        {
          "name": "manifest of a converted video",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const videoId = pm.variables.get(\"video_id\");",
                  "",
                  "if (!videoId) {",
                  "    pm.test.skip(\"skipped: set video_id in the environment to reach the manifest\", function () {});",
                  "} else {",
                  "    pm.test(\"responds 200 OK\", function () {",
                  "        pm.response.to.have.status(200);",
                  "    });",
