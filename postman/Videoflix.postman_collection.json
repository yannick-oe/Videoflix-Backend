    {
      "name": "7 Password reset",
      "description": "The reset answers the same 200 for a known and an unknown address. A successful password_confirm cannot be reached from a runner because its token leaves the system by email only, so this folder checks the rejected link.",
      "item": [
        {
          "name": "reset for the address of this run",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responds 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
